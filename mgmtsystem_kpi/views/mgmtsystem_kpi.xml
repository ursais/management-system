<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mgmtsystem_kpi_list" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.list</field>
        <field name="model">mgmtsystem.kpi</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="value" />
                <field name="category_id" />
                <field name="kpi_type" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_filter" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.filter</field>
        <field name="model">mgmtsystem.kpi</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search string="KPI">
                <field name="name" />
                <field name="category_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                    help="Only active KPIs are computed by the scheduler based on the periodicity configuration."
                />
                <group>
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'category_id'}"
                    />
                    <filter
                        name="group_type"
                        string="Type"
                        context="{'group_by': 'kpi_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_form" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.form</field>
        <field name="model">mgmtsystem.kpi</field>
        <field name="arch" type="xml">
            <form string="Key Performance Indicator">
                <header>
                    <button
                        name="compute_kpi_value"
                        string="Compute KPI Now"
                        type="object"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="category_id" />
                            <field name="threshold_id" />
                        </group>
                        <group>
                            <field name="value" />
                            <field name="active" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="date" />
                                    <field name="value" />
                                    <field name="color" widget="color" />
                                </list>
                            </field>
                        </page>
                        <page string="Computation">
                            <group>
                                <field name="periodicity" />
                                <field name="periodicity_uom" />
                                <field name="next_execution_date" />
                            </group>
                            <group string="KPI Computation">
                                <field name="kpi_type" />
                                <field name="kpi_code" />
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_history_list" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.history.list</field>
        <field name="model">mgmtsystem.kpi.history</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date" />
                <field name="value" />
                <field name="color" widget="color" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="action_mgmtsystem_kpi" model="ir.actions.act_window">
        <field name="name">Key Performance Indicators</field>
        <field name="res_model">mgmtsystem.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mgmtsystem_kpi_filter" />
    </record>
</odoo>
