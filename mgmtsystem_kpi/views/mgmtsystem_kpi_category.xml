<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mgmtsystem_kpi_category_list" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.category.list</field>
        <field name="model">mgmtsystem.kpi.category</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_category_form" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.category.form</field>
        <field name="model">mgmtsystem.kpi.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmtsystem_kpi_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">mgmtsystem.kpi.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
