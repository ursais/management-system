<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mgmtsystem_kpi_threshold_range_list" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.threshold.range.list</field>
        <field name="model">mgmtsystem.kpi.threshold.range</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="min_value" />
                <field name="max_value" />
                <field name="color" widget="color" />
                <field name="invalid_message" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_threshold_range_form" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.threshold.range.form</field>
        <field name="model">mgmtsystem.kpi.threshold.range</field>
        <field name="arch" type="xml">
            <form string="Range">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group string="Minimum">
                        <field name="min_type" />
                        <field
                            name="min_fixed_value"
                            invisible="min_type != 'static'"
                        />
                        <field
                            name="min_code"
                            invisible="min_type not in ('local', 'python')"
                        />
                    </group>
                    <group string="Maximum">
                        <field name="max_type" />
                        <field
                            name="max_fixed_value"
                            invisible="max_type != 'static'"
                        />
                        <field
                            name="max_code"
                            invisible="max_type not in ('local', 'python')"
                        />
                    </group>
                    <group string="Thresholds">
                        <field name="threshold_ids" nolabel="1" />
                    </group>
                    <field name="invalid_message" invisible="not invalid_message" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmtsystem_kpi_threshold_range" model="ir.actions.act_window">
        <field name="name">Ranges</field>
        <field name="res_model">mgmtsystem.kpi.threshold.range</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
