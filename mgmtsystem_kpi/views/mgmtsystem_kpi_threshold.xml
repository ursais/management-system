<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mgmtsystem_kpi_threshold_list" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.threshold.list</field>
        <field name="model">mgmtsystem.kpi.threshold</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="invalid_message" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_mgmtsystem_kpi_threshold_form" model="ir.ui.view">
        <field name="name">mgmtsystem.kpi.threshold.form</field>
        <field name="model">mgmtsystem.kpi.threshold</field>
        <field name="arch" type="xml">
            <form string="Threshold">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group string="Ranges">
                        <field name="range_ids" nolabel="1" />
                    </group>
                    <group string="KPIs">
                        <field name="kpi_ids" nolabel="1" />
                    </group>
                    <field name="invalid_message" invisible="not invalid_message" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mgmtsystem_kpi_threshold" model="ir.actions.act_window">
        <field name="name">Thresholds</field>
        <field name="res_model">mgmtsystem.kpi.threshold</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
